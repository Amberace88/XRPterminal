# ---------------------------------------------------------------
# XRP Terminal — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; all others are server-only.
# Every integration is optional: when a variable is missing the related
# feature shows "Data source not connected" instead of inventing data.
# ---------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://xrpterminal.com

# Supabase (auth + database). Enables accounts, cloud persistence, forecast history, admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI Intelligence, Claim Check, AI Trade Coach)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PROPLUS_MONTHLY=

# Encryption key for read-only exchange credentials (32 bytes, base64). Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Secret used by scheduled jobs (cron) to call internal job endpoints
CRON_SECRET=

# Optional provider keys
CRYPTOCOMPARE_API_KEY=

# Email alerts (Resend) — optional
RESEND_API_KEY=
ALERTS_EMAIL_FROM=

# OAuth providers shown on login (comma list, e.g. google,github) — configure them in Supabase first
NEXT_PUBLIC_AUTH_PROVIDERS=
NEXT_PUBLIC_CONTACT_EMAIL=
# Salt for hashing referral click IPs
REFERRAL_HASH_SALT=
